    "install:all": "npm install && npm run install:client",
    "clean": "rimraf public/*"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "morgan": "~1.9.1"
